# Copy this file to .env and adjust. Generate the secret key with:
#   scripts/generate-secret.sh
#
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*
REDIS_URL=redis://redis:6379/0
DB_PATH=/app/data/db.sqlite3

# Checking agent (OpenAI-compatible LLM + one-shot container orchestration)
AGENT_IMAGE=dyano-checker-agent
AGENT_MEDIA_VOLUME=dyano-checker_media_data
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=gpt-4o-mini
